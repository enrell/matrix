prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: matrix-component
Description: Matrix external-component SDK for C/C++ (ML1 experimental 0.x)
Version: 0.1.0
Libs: -L${libdir} -lmatrix-component -lpthread
Cflags: -I${includedir}
